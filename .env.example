# Admin panel login (fall back to weak defaults if unset — always set these in production)
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Google Drive is the only store for waivers (no Vercel Blob).
# Service account key file contents (raw JSON or base64). The account must be a
# Content manager on the target folder, which may live in a Shared Drive.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Target folder ID (from its URL: drive.google.com/drive/folders/<THIS_PART>)
GOOGLE_DRIVE_FOLDER_ID=
